3:Teaa,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://nevadesign.fr/#organization","name":"Neva Design","url":"https://nevadesign.fr","logo":"https://nevadesign.fr/brand/logo-noir-large.png","sameAs":["https://nevadesign.fr"]},{"@type":"WebSite","@id":"https://nevadesign.fr/#website","url":"https://nevadesign.fr","name":"Neva Design","alternateName":["Neva Design","Neva Design Studio","Neva AI"],"description":"Neva Design compose les visuels de votre serveur FiveM avec une vraie direction artistique : packs complets, bannières Discord, affiches, loading screens et scènes GTA génératives. Brief sur Discord, rendus prêts à publier, exports jusqu'en 8K.","inLanguage":"fr-FR","publisher":{"@id":"https://nevadesign.fr/#organization"}},{"@type":"SoftwareApplication","@id":"https://nevadesign.fr/#software","name":"Neva Design","alternateName":"Neva Design AI","applicationCategory":"DesignApplication","operatingSystem":"Web","url":"https://nevadesign.fr","image":"https://nevadesign.fr/brand/og.jpg","description":"Neva Design compose les visuels de votre serveur FiveM avec une vraie direction artistique : packs complets, bannières Discord, affiches, loading screens et scènes GTA génératives. Brief sur Discord, rendus prêts à publier, exports jusqu'en 8K.","keywords":"Neva Design, Neva AI, studio créatif FiveM, graphiste FiveM, pack graphique FiveM, bannière Discord FiveM, affiche FiveM, loading screen FiveM, overlay stream, scène GTA IA, FiveM IA, GTA RP design, design gaming, direction artistique IA","brand":{"@id":"https://nevadesign.fr/#organization"},"offers":{"@type":"Offer","price":"0","priceCurrency":"EUR","availability":"https://schema.org/InStock"},"audience":{"@type":"Audience","audienceType":"Youtubeurs et créateurs de contenu, entrepreneurs et marques, équipes esport, serveurs GTA RP et communautés gaming"}},{"@type":"FAQPage","@id":"https://nevadesign.fr/#faq","mainEntity":[{"@type":"Question","name":"Neva Design, c’est quoi exactement ?","acceptedAnswer":{"@type":"Answer","text":"Un studio créatif complet piloté par IA : vous décrivez une intention, il compose packs FiveM, bannières, affiches et scènes GTA prêts à publier — avec une vraie direction artistique, pas une génération au hasard."}},{"@type":"Question","name":"Que vaut vraiment le plan gratuit ?","acceptedAnswer":{"@type":"Answer","text":"Le plan Découverte permet d'explorer le flux complet, brief compris, sans créditer de créations. Les formules débloquent les exports HD, l’usage commercial et la priorité de génération"}},{"@type":"Question","name":"Puis-je vendre ce que je crée ?","acceptedAnswer":{"@type":"Answer","text":"Oui. Dès le premier plan payant, chaque création vous appartient commercialement : serveur, boutique, réseaux, livrables clients."}},{"@type":"Question","name":"Le Creative Director, encore un chatbot ?","acceptedAnswer":{"@type":"Answer","text":"Non. Il connaît vos références, votre historique et les codes de votre terrain — pack serveur, bannière Discord ou affiche GTA RP. Il propose des concepts, structure des briefs et peut lancer une génération depuis la conversation."}},{"@type":"Question","name":"Je ne sais pas designer. C’est un problème ?","acceptedAnswer":{"@type":"Answer","text":"C’est exactement pour ça que Neva existe. Décrivez le résultat voulu ; la composition, la typographie et l'étalonnage sont pris en charge. Le module Audit vous dit même quoi améliorer."}},{"@type":"Question","name":"Et si je veux arrêter ?","acceptedAnswer":{"@type":"Answer","text":"Deux clics depuis votre espace. Le plan reste actif jusqu'à la fin de la période en cours — rien de caché, rien de retenu."}}]}]}0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","style",null,{"children":"html{color-scheme:dark}body{background-color:#060606;color:#F2F2F0}"}],["$","main",null,{"className":"pv-light min-h-screen text-ink","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":