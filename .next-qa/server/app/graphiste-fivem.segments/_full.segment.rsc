f:T823,{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://nevadesign.fr"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://nevadesign.fr/#solutions"},{"@type":"ListItem","position":3,"name":"Graphiste FiveM","item":"https://nevadesign.fr/graphiste-fivem"}]},{"@type":"Service","name":"Graphiste FiveM","description":"Logo, loading screen, bannières : créez l’habillage complet de votre serveur RP en minutes avec Neva Design.","url":"https://nevadesign.fr/graphiste-fivem","provider":{"@type":"Organization","name":"Neva Design","url":"https://nevadesign.fr"},"areaServed":"FR"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Neva remplace-t-il complètement un graphiste ?","acceptedAnswer":{"@type":"Answer","text":"Pour l’habillage courant d’un serveur — logo, loading screen, bannières, affiches —, oui, avec un résultat livré en minutes. Pour une direction artistique très spécifique ou un brief à forte contrainte technique, un graphiste humain reste supérieur. Beaucoup combinent les deux : générer la base sur Neva, puis faire affiner les détails par un professionnel."}},{"@type":"Question","name":"Puis-je utiliser les visuels sur un serveur monétisé ?","acceptedAnswer":{"@type":"Answer","text":"Oui. Les créations sont utilisables commercialement : boutique de dons, pages de packs VIP, publicités pour votre serveur, vidéos monétisées. Vous exportez les fichiers en haute résolution et les intégrez où vous voulez, sans watermark ni licence à racheter plus tard."}},{"@type":"Question","name":"Combien de créations prévoir pour habiller un serveur complet ?","acceptedAnswer":{"@type":"Answer","text":"Comptez 5 à 6 créations : logo, loading screen, bannière Discord, splash d’invitation et deux affiches. La formule Créateur (24 €/mois, 12 créations) couvre un lancement confortablement ; le Pack lancement à 49 € est pensé exactement pour ce scénario, itérations comprises."}}]}]}9:["$","$1","c",{"children":[[["$","style",null,{"children":"html{color-scheme:dark}body{background-color:#060606;color:#F2F2F0}"}],["$","main",null,{"className":"pv-light min-h-screen bg-paper text-ink","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$f"}}],["$","header",null,{"className":"mx-auto flex w-full max-w-[1080px] items-center justify-between px-6 pb-2 pt-7","children":[["$","$L7",null,{"href":"/","className":"font-display text-[17px] font-medium tracking-[-0.01em] text-ink","children":"Neva Design"}],["$","$L7",null,{"href":"/#generative","className":"pv-btn text-[13.5px]","children":["Découvrir Neva Generative",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right","size":14,"strokeWidth":1.8}]]}]]}],["$","article",null,{"className":"mx-auto w-full max-w-[1080px] px-6 pb-24","children":[["$","nav",null,{"aria-label":"Fil d'ariane","className":"mt-8 font-mono text-[10.5px] uppercase tracking-[0.18em] text-mist","children":[["$","$L7",null,{"href":"/","className":"transition-colors hover:text-slate","children":"Accueil"}],["$","span",null,{"aria-hidden":true,"className":"mx-2","children":"/"}],["$","span",null,{"children":"Solutions"}],["$","span",null,{"aria-hidden":true,"className":"mx-2","children":"/"}],["$","span",null,{"className":"text-slate","children":"Graphiste FiveM"}]]}],["$","p",null,{"className":"mt-10 font-mono text-[10.5px] uppercase tracking-[0.2em] text-mist","children":"Solutions — FiveM & GTA RP"}],["$","h1",null,{"className":"mt-4 max-w-[720px] font-display text-[clamp(38px,4.6vw,64px)] font-light leading-[1.05] tracking-[-0.015em] text-ink","children":"Graphiste FiveM"}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}],"$L18"]}]],["$L19"],"$L1a"]}]
