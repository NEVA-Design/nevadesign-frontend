2:T82b,{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://nevadesign.fr"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://nevadesign.fr/#solutions"},{"@type":"ListItem","position":3,"name":"Pack graphique FiveM","item":"https://nevadesign.fr/pack-graphique-fivem"}]},{"@type":"Service","name":"Pack graphique FiveM","description":"Logo, loading screen, bannières et affiches cohérents, en pack dès 19 €, rendus en une soirée. Itérations incluses.","url":"https://nevadesign.fr/pack-graphique-fivem","provider":{"@type":"Organization","name":"Neva Design","url":"https://nevadesign.fr"},"areaServed":"FR"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Pack one-shot ou abonnement : comment choisir ?","acceptedAnswer":{"@type":"Answer","text":"Le pack convient à un besoin ponctuel et délimité — ouvrir le serveur avec tout l’habillage. L’abonnement (24, 59 ou 129 €/mois selon le volume) s’adresse aux serveurs actifs qui publient des affiches d’événements chaque semaine. Beaucoup démarrent au pack puis passent à l’abonnement quand la communauté grandit."}},{"@type":"Question","name":"En combien de temps puis-je habiller tout mon serveur ?","acceptedAnswer":{"@type":"Answer","text":"Une soirée sérieuse suffit : charte en début de session, puis logo, loading screen, bannières et affiches dans la foulée, chaque visuel demandant quelques minutes plus vos itérations. Comparez avec les deux à trois semaines habituelles d’un pack commandé à un indépendant déjà occupé."}},{"@type":"Question","name":"Puis-je compléter mon pack plus tard sans casser le style ?","acceptedAnswer":{"@type":"Answer","text":"Oui : c’est l’intérêt de la charte. Un événement de Noël, un partenariat, une nouvelle faction — vous régénérez à partir des mêmes fondations, à l’unité via les recharges à 2,90 € ou dans votre quota mensuel. Le style tient parce qu’il est documenté, pas mémorisé."}}]}]}0:{"rsc":["$","$1","c",{"children":[[["$","style",null,{"children":"html{color-scheme:dark}body{background-color:#060606;color:#F2F2F0}"}],["$","main",null,{"className":"pv-light min-h-screen bg-paper text-ink","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","header",null,{"className":"mx-auto flex w-full max-w-[1080px] items-center justify-between px-6 pb-2 pt-7","children":[["$","$L3",null,{"href":"/","className":"font-display text-[17px] font-medium tracking-[-0.01em] text-ink","children":"Neva Design"}],["$","$L3",null,{"href":"/#generative","className":"pv-btn text-[13.5px]","children":["Découvrir Neva Generative",["$","$L4",null,{"iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right","size":14,"strokeWidth":1.8}]]}]]}],["$","article",null,{"className":"mx-auto w-full max-w-[1080px] px-6 pb-24","children":[["$","nav",null,{"aria-label":"Fil d'ariane","className":"mt-8 font-mono text-[10.5px] uppercase tracking-[0.18em] text-mist","children":[["$","$L3",null,{"href":"/","className":"transition-colors hover:text-slate","children":"Accueil"}],["$","span",null,{"aria-hidden":true,"className":"mx-2","children":"/"}],["$","span",null,{"children":"Solutions"}],["$","span",null,{"aria-hidden":true,"className":"mx-2","children":"/"}],["$","span",null,{"className":"text-slate","children":"Pack graphique FiveM"}]]}],["$","p",null,{"className":"mt-10 font-mono text-[10.5px] uppercase tracking-[0.2em] text-mist","children":"Solutions — FiveM & GTA RP"}],["$","h1",null,{"className":"mt-4 max-w-[720px] font-display text-[clamp(38px,4.6vw,64px)] font-light leading-[1.05] tracking-[-0.015em] text-ink","children":"Pack graphique FiveM"}],"$L5","$L6","$L7","$L8","$L9","$La","$Lb"]}],"$Lc"]}]],["$Ld"],"$Le"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"KlV9-wUyQkL3JuFihLMDs"}
5:["$","div",null,{"className":"mt-6 max-w-[640px] space-y-4 text-[15.5px] leading-[1.7] text-slate","children":[["$","p","Commander ses visuels un par un,",{"children":"Commander ses visuels un par un, à des moments différents, parfois à des personnes différentes : voilà comment un serveur se retrouve avec un logo bleu, un loading screen orange et des affiches qui semblent venir d’une autre ville. Un pack graphique FiveM règle le problème à la racine : tous les supports partent de la même charte et sortent ensemble. Avec Neva Design, vous décrivez une seule fois votre univers — époque, ambiance, couleurs — puis vous déclinez logo, écran de chargement, bannières Discord et affiches dans la foulée, avec des itérations illimitées dans votre quota et des exports jusqu’en 8K. Les packs one-shot démarrent à 19 €, et l’inscription reste gratuite et sans carte bancaire pour découvrir le studio avant d’engager quoi que ce soit."}]]}]
