7:["$","div",null,{"className":"mt-14 grid grid-cols-2 gap-4 md:grid-cols-4","children":[["$","figure","/neva-design/logos/EFINAL.webp",{"className":"pv-print relative overflow-hidden aspect-[16/9]","children":["$","$Lf",null,{"src":"/neva-design/logos/EFINAL.webp","alt":"Emblème esport E Final","fill":true,"sizes":"(max-width: 768px) 46vw, 250px","className":"object-cover"}]}],["$","figure","/neva-design/logos/krlogo.webp",{"className":"pv-print relative overflow-hidden aspect-[16/9]","children":["$","$Lf",null,{"src":"/neva-design/logos/krlogo.webp","alt":"Monogramme chrome KR","fill":true,"sizes":"(max-width: 768px) 46vw, 250px","className":"object-cover"}]}],["$","figure","/neva-design/logos/vulcainlogo.webp",{"className":"pv-print relative overflow-hidden aspect-[16/9]","children":["$","$Lf",null,{"src":"/neva-design/logos/vulcainlogo.webp","alt":"Logo Vulcain, V ailé","fill":true,"sizes":"(max-width: 768px) 46vw, 250px","className":"object-cover"}]}],["$","figure","/neva-design/logos/Xlogo.webp",{"className":"pv-print relative overflow-hidden aspect-[16/9]","children":["$","$Lf",null,{"src":"/neva-design/logos/Xlogo.webp","alt":"Monogramme chrome X","fill":true,"sizes":"(max-width: 768px) 46vw, 250px","className":"object-cover"}]}]]}]
8:["$","div",null,{"className":"mt-16 max-w-[680px]","children":[["$","section","From server name to emblem in one session",{"className":"mt-12 first:mt-0","children":[["$","h2",null,{"className":"font-display text-[clamp(24px,2.4vw,32px)] font-light leading-[1.15] tracking-[-0.01em] text-ink","children":"From server name to emblem in one session"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15px] leading-[1.75] text-slate","children":[["$","p","Start with the sentence you woul",{"children":"Start with the sentence you would give a human designer: \"coastal city RP, 1990s mood, teal neon and chrome, palm silhouette, serious but not grim.\" The first proposal arrives in minutes. From there you iterate in plain words — swap the typeface, mute the palette, try a badge shape instead of a wordmark — until the emblem feels inevitable. Because revisions draw from your quota rather than an invoice, exploring a wrong turn costs nothing. Most owners land a final logo in a single evening, declensions included."}]]}]]}],["$","section","One city, a whole family of badges",{"className":"mt-12 first:mt-0","children":[["$","h2",null,{"className":"font-display text-[clamp(24px,2.4vw,32px)] font-light leading-[1.15] tracking-[-0.01em] text-ink","children":"One city, a whole family of badges"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15px] leading-[1.75] text-slate","children":[["$","p","A server logo rarely stays alone",{"children":"A server logo rarely stays alone. Departments and factions want their own marks: police, EMS, the mechanic shop, the taxi company, player-run businesses. Generate the main crest first, then derive each sub-badge from the same brief so the whole city feels governed by one visual law. It is the difference between a roleplay world and a collage. The €19 identity pack covers a main logo with its declensions; larger faction families fit comfortably in the Creator plan’s 12 monthly creations."}]]}]]}],["$","section","What survives the server list",{"className":"mt-12 first:mt-0","children":[["$","h2",null,{"className":"font-display text-[clamp(24px,2.4vw,32px)] font-light leading-[1.15] tracking-[-0.01em] text-ink","children":"What survives the server list"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15px] leading-[1.75] text-slate","children":[["$","p","Your logo will mostly live small",{"children":"Your logo will mostly live small and on dark interfaces: the Discord sidebar, the server browser, a phone screen. Design for that reality. Favor a strong silhouette over fine detail; strokes thinner than 2 pixels vanish at icon size. Check the emblem on near-black backgrounds first, since that is where players meet it. Keep the name short in the mark itself — long city names belong next to the logo, not inside it. And always generate a light-background variant before you need one; partner announcements and documents will ask for it."}]]}]]}]]}]
