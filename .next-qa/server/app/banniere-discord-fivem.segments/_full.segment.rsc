f:T825,{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://nevadesign.fr"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://nevadesign.fr/#solutions"},{"@type":"ListItem","position":3,"name":"Bannière Discord FiveM","item":"https://nevadesign.fr/banniere-discord-fivem"}]},{"@type":"Service","name":"Bannière Discord FiveM","description":"Créez bannière, splash d’invitation et icône Discord assortis pour votre serveur FiveM, aux bonnes dimensions.","url":"https://nevadesign.fr/banniere-discord-fivem","provider":{"@type":"Organization","name":"Neva Design","url":"https://nevadesign.fr"},"areaServed":"FR"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Quelles tailles dois-je demander exactement ?","acceptedAnswer":{"@type":"Answer","text":"Bannière de serveur : 960 × 540 minimum, en 16:9 — générez plus grand, Discord redimensionne proprement. Splash d’invitation : 1920 × 1080. Icône : 512 × 512, avec l’élément principal centré pour survivre au recadrage rond. Couverture d’événement : 800 × 320, un format très horizontal à anticiper dès la composition."}},{"@type":"Question","name":"Puis-je obtenir une bannière animée ?","acceptedAnswer":{"@type":"Answer","text":"Non, Neva génère des images fixes. Une bannière animée (GIF, réservée au niveau de boost 3) devra passer par un motion designer. En pratique, une image fixe contrastée et bien composée fait déjà l’essentiel du travail d’attractivité pour un serveur RP."}},{"@type":"Question","name":"Comment garder icône, bannière et splash cohérents entre eux ?","acceptedAnswer":{"@type":"Answer","text":"Générez d’abord votre charte graphique (couleurs, typographies, ambiance), puis demandez chaque format en vous y référant dans la description. Les trois visuels partagent alors la même base au lieu d’être trois images indépendantes. C’est la méthode utilisée pour les packs serveur visibles sur /neva-design."}}]}]}9:["$","$1","c",{"children":[[["$","style",null,{"children":"html{color-scheme:dark}body{background-color:#060606;color:#F2F2F0}"}],["$","main",null,{"className":"pv-light min-h-screen bg-paper text-ink","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$f"}}],["$","header",null,{"className":"mx-auto flex w-full max-w-[1080px] items-center justify-between px-6 pb-2 pt-7","children":[["$","$L7",null,{"href":"/","className":"font-display text-[17px] font-medium tracking-[-0.01em] text-ink","children":"Neva Design"}],["$","$L7",null,{"href":"/#generative","className":"pv-btn text-[13.5px]","children":["Découvrir Neva Generative",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right","size":14,"strokeWidth":1.8}]]}]]}],["$","article",null,{"className":"mx-auto w-full max-w-[1080px] px-6 pb-24","children":[["$","nav",null,{"aria-label":"Fil d'ariane","className":"mt-8 font-mono text-[10.5px] uppercase tracking-[0.18em] text-mist","children":[["$","$L7",null,{"href":"/","className":"transition-colors hover:text-slate","children":"Accueil"}],["$","span",null,{"aria-hidden":true,"className":"mx-2","children":"/"}],["$","span",null,{"children":"Solutions"}],["$","span",null,{"aria-hidden":true,"className":"mx-2","children":"/"}],["$","span",null,{"className":"text-slate","children":"Bannière Discord FiveM"}]]}],["$","p",null,{"className":"mt-10 font-mono text-[10.5px] uppercase tracking-[0.2em] text-mist","children":"Solutions — FiveM & GTA RP"}],["$","h1",null,{"className":"mt-4 max-w-[720px] font-display text-[clamp(38px,4.6vw,64px)] font-light leading-[1.05] tracking-[-0.015em] text-ink","children":"Bannière Discord FiveM"}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}],"$L18"]}]],["$L19"],"$L1a"]}]
