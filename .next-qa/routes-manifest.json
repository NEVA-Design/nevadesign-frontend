          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:\\.(webp|avif|png|jpg|jpeg|gif|svg|ico|woff2))(?:/)?$"
    }
